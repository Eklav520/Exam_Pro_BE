NODE_ENV=development
PORT=5000
# Comma-separated exact origins. Required when NODE_ENV=production.
CORS_ORIGINS=http://localhost:5173
# Atlas: Cluster > Connect > Drivers. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=exam_pro
# Number of reverse proxies in front of the app (0 when run directly).
TRUST_PROXY_HOPS=0
# Signs login tokens. At least 32 random characters, different per environment:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_HOURS=12
